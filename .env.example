# 真人发音音频用的 Merriam-Webster 词典 API key（https://dictionaryapi.com 免费申请）。
# 留空也能用：会退化成 edge-tts 合成语音，再退化成浏览器本地朗读，只是不是真人发音。
MW_API_KEY=

# 主服务端口，默认 30031。只在这个端口被别的程序占了的时候才需要改。
# 在这里改而不是敲 `PORT=30041 npm start`——后者是 POSIX shell 语法，Windows 上跑不通。
# PORT=30041

# 降级用的 Vosk 模型规格：large（默认，125MB）或 small。设置页里也能切。
# VOSK_MODEL=large

# 音素识别模型从哪儿下。默认先查本地缓存，要下就走 ModelScope，不通自动回落
# HuggingFace。钉死某一个的话取不到会明确报错，不偷偷换源。
# 实测这台机器上 ModelScope 快得多（整包 1205MB 约 37 秒），所以默认走它。
# MODEL_SOURCE=modelscope

# 走 HuggingFace 那条路时换个镜像。注意它接管不了 ModelScope（同上那篇有实测）。
# HF_ENDPOINT=https://hf-mirror.com

# 起服务时不自动开浏览器。默认会开，而且不会重复开（server/src/index.ts）。
# NO_OPEN=1
